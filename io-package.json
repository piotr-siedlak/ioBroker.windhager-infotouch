{
    "common": {
        "name": "windhager-infotouch",
        "version": "0.2.0",
        "news": {
            "0.2.0": {
                "en": "Readable names for datapoints, menu groups and enum values from the controller text tables",
                "pl": "Czytelne nazwy punktów danych, grup menu i wartości wyliczeń z tabel tekstów sterownika",
                "de": "Lesbare Namen für Datenpunkte, Menügruppen und Aufzählungswerte aus den Texttabellen des Reglers"
            },
            "0.1.2": {
                "en": "Adapter renamed to windhager-infotouch to match the repository; installs from GitHub work",
                "pl": "Adapter przemianowany na windhager-infotouch zgodnie z nazwą repozytorium; instalacja z GitHub działa",
                "de": "Adapter in windhager-infotouch umbenannt (passend zum Repository); Installation von GitHub funktioniert"
            },
            "0.1.1": {
                "en": "Review fixes: offline detection, per-group error isolation, defensive paging, cache invalidation, export masking",
                "pl": "Poprawki po przeglądzie: wykrywanie braku połączenia, izolacja błędów grup, bezpieczne stronicowanie, unieważnianie cache, maskowanie eksportu",
                "de": "Review-Korrekturen: Offline-Erkennung, Fehlerisolierung pro Gruppe, defensives Paging, Cache-Invalidierung, Maskierung im Export"
            },
            "0.1.0": {
                "en": "Initial beta: read-only discovery and polling, opt-in verified writes",
                "pl": "Pierwsza wersja beta: odczyt, wykrywanie i odpytywanie; zapis tylko po jawnym włączeniu",
                "de": "Erste Beta: Auslesen, Erkennung und Polling; Schreiben nur nach ausdrücklicher Freigabe"
            }
        },
        "title": "Windhager InfoWIN Touch",
        "titleLang": {
            "en": "Windhager InfoWIN Touch",
            "pl": "Windhager InfoWIN Touch",
            "de": "Windhager InfoWIN Touch"
        },
        "desc": {
            "en": "Local, capability-driven integration of Windhager InfoWIN Touch / MES INFINITY heating controllers (read-only by default)",
            "pl": "Lokalna integracja sterowników grzewczych Windhager InfoWIN Touch / MES INFINITY (domyślnie tylko odczyt)",
            "de": "Lokale Integration von Windhager InfoWIN Touch / MES INFINITY Heizungsreglern (standardmäßig nur lesend)"
        },
        "authors": ["piotr-siedlak <siedlak.piotr@gmail.com>"],
        "keywords": ["windhager", "infowin", "heating", "boiler", "gas", "pellet"],
        "licenseInformation": {
            "license": "MIT",
            "type": "free"
        },
        "platform": "Javascript/Node.js",
        "icon": "windhager-infotouch.svg",
        "enabled": true,
        "extIcon": "https://raw.githubusercontent.com/piotr-siedlak/ioBroker.windhager-infotouch/main/admin/windhager-infotouch.svg",
        "readme": "https://github.com/piotr-siedlak/ioBroker.windhager-infotouch/blob/main/README.md",
        "loglevel": "info",
        "tier": 3,
        "mode": "daemon",
        "type": "climate-control",
        "compact": false,
        "connectionType": "local",
        "dataSource": "poll",
        "adminUI": {
            "config": "json"
        },
        "messagebox": true,
        "supportedMessages": {
            "custom": false
        },
        "dependencies": [
            {
                "js-controller": ">=5.0.19"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=6.17.14"
            }
        ],
        "restartAdapters": []
    },
    "native": {
        "host": "",
        "protocol": "http",
        "port": 80,
        "username": "USER",
        "password": "",
        "verifyTls": true,
        "timeoutMs": 15000,
        "maxConcurrency": 2,
        "pollFastSec": 30,
        "pollNormalSec": 60,
        "pollSlowSec": 300,
        "enableFast": true,
        "enableNormal": true,
        "enableSlow": true,
        "pollLon": false,
        "fastGroups": "",
        "excludedNodes": "",
        "exposeRaw": false,
        "cacheMaxAgeHours": 168,
        "writesEnabled": false,
        "writeAllowlist": "",
        "verifyWrites": true,
        "language": ""
    },
    "encryptedNative": ["password"],
    "protectedNative": ["password"],
    "objects": [],
